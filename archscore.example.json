{
  "maxFanOut": 4,
  "historyCommits": 100,
  "minModuleChanges": 5,
  "minCochange": 3,
  "minLocalityRatio": 0.8,
  "includeTests": false,
  "policyMode": "enforced",
  "exclude": ["**/*.test.ts", "**/*_test.go", "**/generated/**"],
  "modules": [
    {
      "name": "domain",
      "paths": ["src/domain/**", "internal/domain/**"],
      "mayDependOn": []
    },
    {
      "name": "application",
      "paths": ["src/application/**", "internal/application/**"],
      "publicPaths": ["src/application/public/**", "internal/application/public/**"],
      "maxPublicSymbols": 20,
      "mayDependOn": ["domain"]
    },
    {
      "name": "infrastructure",
      "paths": ["src/infrastructure/**", "internal/infrastructure/**"],
      "mayDependOn": ["domain", "application"]
    },
    {
      "name": "presentation",
      "paths": ["src/presentation/**", "internal/presentation/**"],
      "mayDependOn": ["application"]
    }
  ]
}
